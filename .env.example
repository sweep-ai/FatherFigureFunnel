# Copy to .env.local for dev. Set the same keys in Vercel → Project → Settings → Environment Variables.
# All VITE_* values are public (bundled into the browser). Never put secrets here.

# --- Sweep OS (required for lead capture + step tracking) ---
# Backend base URL, no trailing slash, no /api prefix.
VITE_SWEEP_API_BASE_URL=https://api.sweepai.site
# Sweep OS → Funnels → Father Figure funnel → Overview tab (UUID).
VITE_SWEEP_FUNNEL_ID=

# --- Booking (required) ---
# GoHighLevel one-on-one calendar widget URL (Calendar → Share → embed URL),
# e.g. https://api.leadconnectorhq.com/widget/booking/XXXXXXXX
# A Calendly inline URL also works.
VITE_BOOKING_URL=

# --- Media (optional until recorded) ---
# Self-hosted MP4 URLs (Vercel Blob / CDN / /videos/*.mp4). Blank = "coming soon" poster.
VITE_VSL_URL=
VITE_POST_BOOKING_VSL_URL=

# --- Analytics (optional) ---
VITE_CLARITY_PROJECT_ID=

# --- DQ resource (optional) ---
# Link to the free 7-Day Dad Comeback Blueprint (PDF / Canva share / GHL opt-in page).
VITE_BLUEPRINT_URL=
# Phone the confirmation call/text comes from, shown on the post-booking page.
VITE_CONFIRM_PHONE=
